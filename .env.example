# ─────────────────────────────────────────────
#  WhatsApp → Google Calendar Bot — Variables
# ─────────────────────────────────────────────

# ID del grupo de WhatsApp que el bot debe escuchar.
# Formato: "XXXXXXXXXXXXXXXXXX@g.us"
# Cómo obtenerlo: descomenta el bloque de log en index.js para verlo en consola.
WHATSAPP_GROUP_ID=

# Zona horaria local para interpretar fechas relativas ("el lunes", "mañana", etc.)
# Ejemplos: "Europe/Madrid", "America/Bogota", "America/Mexico_City"
TIMEZONE=Europe/Madrid

# Ruta al archivo de credenciales OAuth2 descargado desde Google Cloud Console.
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Ruta donde se guardará el token de acceso de Google tras la primera autorización.
GOOGLE_TOKEN_PATH=./token.json

# Calendario destino en Google Calendar.
# Usa "primary" para el calendario principal o el ID de un calendario específico.
GOOGLE_CALENDAR_ID=primary

# Clave de API de Mistral para procesar carteles e interpretar mensajes (tier gratuito).
# Obtén la tuya en: https://console.mistral.ai → API Keys
# Si no la configuras, las imágenes y textos no se procesarán.
MISTRAL_API_KEY=
